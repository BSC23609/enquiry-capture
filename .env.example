# --- Azure app registration (Entra ID) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Mailbox to watch
MAILBOX=sales@bharatsteels.in
MAILBOX_FOLDER=inbox

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Neon ---
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# --- Behaviour ---
MAX_MESSAGES_PER_RUN=100
LOOKBACK_DAYS=7
INTERNAL_DOMAINS=bharatsteels.in,metfraa.com,crayonroofings.com,vestrics.in

# --- OneDrive mirror (customer book) ---
# Reuses the Azure app creds; needs Files.ReadWrite.All (application) + admin consent.
# GRAPH_* fall back to MS_* if unset, so you can leave these blank to reuse the same app.
GRAPH_DRIVE_USER=ai@bharatsteels.in
GRAPH_MIRROR_FOLDER=Enquiry Capture
GRAPH_MIRROR_FILENAME=Customer_Master.xlsx
# Set MIRROR_ALWAYS=1 to re-upload every run even when nothing changed (else only on change)
MIRROR_ALWAYS=
